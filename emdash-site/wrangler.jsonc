{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "miaochuang-emdash-host",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "miaochuang-emdash-host",
			"database_id": "5a67cf18-d1b2-4110-a9a4-7350786a3d70",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "abd96b4b9d834281af9b8f711964eb7b",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "miaochuang-emdash-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
}
