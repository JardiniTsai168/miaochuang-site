{
  "$schema": "https://emdashcms.com/seed.schema.json",
  "version": "1",
  "meta": {
    "name": "秒創網站 EmDash Host",
    "description": "秒創網站共用發布站台",
    "author": "lihi"
  },
  "settings": {
    "title": "秒創網站",
    "tagline": "Powered by lihi"
  },
  "collections": [
    {
      "slug": "sites",
      "label": "秒創網站",
      "labelSingular": "網站",
      "urlPattern": "/s/{slug}",
      "supports": ["drafts", "revisions", "preview"],
      "fields": [
        { "slug": "name", "label": "品牌／店家名稱", "type": "string", "required": true },
        {
          "slug": "template",
          "label": "版型",
          "type": "select",
          "required": true,
          "options": ["editorial", "vivid", "calm", "compact", "mosaic"]
        },
        { "slug": "html", "label": "網站 HTML", "type": "text", "required": true },
        { "slug": "expires_at", "label": "預覽到期時間", "type": "datetime", "required": true }
      ]
    }
  ]
}
